# 多人协作版的人员名单（格式示例；发布包已默认提供 users.yaml，这里仅作参考）
#
# 组别固定为 RA / EAMA / UDI / SUPPLY CHAIN / ADMIN（大写，不能改名）；
# 组别键就是角色，每条记录不再写 role 字段。
# 登录时按组别决定能做什么；Admin 需要密码（密码写死在程序里）。
# 这里不记录域账号：登录只记录各电脑自己的操作系统用户名。
users:
  RA:
    name: "张三"
    email: "zhangsan@example.com"
    note: "RA 组（RA 信息）"
  EAMA:
    name: "李四"
    email: "lisi@example.com"
    note: "EAMA（产品类别 + 医保代码）"
  UDI:
    name: "王五"
    email: "wangwu@example.com"
    note: "Global UDI Team"
  SUPPLY CHAIN:
    name: "赵六"
    email: "zhaoliu@example.com"
    note: "Supply Chain（整合）"
  ADMIN:
    name: "管理员"
    email: "admin@example.com"
    note: "Admin（登录需要密码）"
