# build output
/bin/
/dist/
/build/
*.exe
*.app
*.test

# release package (produced by the packaging scripts)
/release/

# snapshot output of `ssr-core snapshot`
/baseline-go/
/perf-go/

# local data (never committed: staging tables, logs, exports, samples)
/data/input/
/data/*.sqlite3
/data/*.sqlite3-*
/output/

# editor / OS noise
.DS_Store
*.swp

# 验收截图等临时文件不要进仓库（历史材料归档在 docs/archive/）
/*.png
/*.jpg

# frontend (React + antd)：源码与构建产物都提交，只有依赖目录不入库
/frontend/node_modules/
