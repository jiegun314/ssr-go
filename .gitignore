# build output
/bin/
/dist/
/build/
*.exe
*.app
*.test

# release package (produced by the packaging scripts)
/release/

# snapshot output of `ssr-core snapshot`
/baseline-go/
/perf-go/

# local data (never committed: staging tables, logs, exports, samples)
/data/input/
/data/*.sqlite3
/data/*.sqlite3-*
/output/

# editor / OS noise
.DS_Store
*.swp

# 验收截图等临时文件不要进仓库（截图归档在 ssr_go/docs/rewrite/）
/*.png
/*.jpg
